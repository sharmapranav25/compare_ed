# Anthropic — required for the extraction pipeline
ANTHROPIC_API_KEY=sk-ant-...

# Slack bot — required to run `python -m buysheet_v2.slack_bot`
#
# Get these by creating an app at https://api.slack.com/apps:
#   1. Create New App -> From scratch
#   2. Socket Mode -> enable; Generate an App-Level Token with scope
#      `connections:write` -> that token is SLACK_APP_TOKEN (xapp-...)
#   3. OAuth & Permissions -> Bot Token Scopes:
#        channels:history, chat:write, files:read, files:write
#      Install to workspace -> Bot User OAuth Token is SLACK_BOT_TOKEN (xoxb-...)
#   4. Event Subscriptions -> enable; subscribe to bot events: `message.channels`
#      (Socket Mode means no Request URL is needed.)
#   5. Invite the bot to the channel: /invite @YourBotName
#   6. Copy the channel ID into SLACK_CHANNEL_ID below to scope the bot to one
#      channel. (Click the channel name -> "About" tab -> copy the ID at the
#      bottom; it starts with C... for public channels, D... for DMs.)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C0123456789

# Optional — defaults to INFO. Set to DEBUG for verbose Bolt logs.
# LOG_LEVEL=INFO

# Gemini — required only for `tools/extract_compare.py` (head-to-head
# benchmarking against Sonnet) or future Gemini-as-judge integration.
# Get a key at https://aistudio.google.com/app/apikey (free tier available).
# GEMINI_API_KEY=your-key-here

# Optional — override the Gemini model used by extract_compare.
# Default: gemini-2.5-pro. Cheaper alternative: gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-pro
